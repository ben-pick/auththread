{
  "name": "@auththread/runtime-node",
  "version": "0.2.0",
  "description": "Node runtime: in-memory or SQLite buffer, poll scheduler, JSON settings, Effect HTTP server layer.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --fsModuleCachePath ./.vitest-cache",
    "build": "node ../../../scripts/build-package.ts",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@auththread/adapter-kit": "workspace:^",
    "@auththread/schema": "workspace:^",
    "@auththread/stitcher": "workspace:^",
    "@effect/platform-node": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ben-pick/auththread.git",
    "directory": "packages/runtimes/node"
  },
  "homepage": "https://github.com/ben-pick/auththread#readme",
  "bugs": {
    "url": "https://github.com/ben-pick/auththread/issues"
  },
  "engines": {
    "node": ">=22.5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "author": "Auththread contributors",
  "keywords": [
    "auth",
    "observability",
    "node",
    "server",
    "sqlite"
  ]
}
