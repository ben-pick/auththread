{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auththread.dev/schema/wide-event-2.json",
  "title": "auththread wide event",
  "type": "object",
  "required": [
    "schemaVersion",
    "event",
    "traceId",
    "spanId",
    "kind",
    "outcome",
    "provider",
    "tenant",
    "startedAt",
    "durationMs",
    "attributes",
    "steps",
    "correlationCounts"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2"
    },
    "event": {
      "const": "auth.journey"
    },
    "traceId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "spanId": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "login",
        "signup",
        "reset",
        "step_up"
      ]
    },
    "outcome": {
      "type": "string",
      "enum": [
        "success",
        "failed",
        "abandoned",
        "denied"
      ]
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "tenant": {
      "type": "string",
      "minLength": 1
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "durationMs": {
      "type": "number",
      "minimum": 0
    },
    "attributes": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        ]
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "ui",
              "hook",
              "app",
              "provider"
            ]
          },
          "startOffsetMs": {
            "type": "number",
            "minimum": 0
          },
          "durationMs": {
            "type": "number",
            "minimum": 0
          },
          "stage": {
            "type": "string",
            "enum": [
              "identify",
              "authenticate",
              "verify",
              "enroll",
              "select",
              "consent",
              "recover",
              "status",
              "custom"
            ]
          },
          "method": {
            "type": "string",
            "enum": [
              "password",
              "social",
              "enterprise_sso",
              "passwordless",
              "passkey",
              "mfa"
            ]
          },
          "vendorScreen": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,95}$"
          },
          "decision": {
            "type": "string"
          },
          "errorCode": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "type",
          "startOffsetMs",
          "durationMs"
        ],
        "additionalProperties": false
      }
    },
    "correlationCounts": {
      "type": "object",
      "properties": {
        "exact": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "inferred": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "exact",
        "inferred"
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
