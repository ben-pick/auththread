{
  "title": "auththread: login journeys",
  "uid": "auththread-journeys",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Loki",
        "type": "datasource",
        "query": "loki",
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Journeys by outcome",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (count_over_time({service_name=\"auththread\"} | json [$__interval]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Failure and denial rate",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "unit": "percentunit"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service_name=\"auththread\"} | json | outcome=~\"failed|denied\" [$__range])) / sum(count_over_time({service_name=\"auththread\"} | json [$__range]))"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Abandoned journeys",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service_name=\"auththread\"} | json | outcome=\"abandoned\" [$__range]))"
        }
      ]
    },
    {
      "id": 4,
      "type": "table",
      "title": "Journey duration by provider",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "avg_over_time({service_name=\"auththread\"} | json | unwrap durationMs [$__interval]) by (provider)"
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Outcomes by provider and method",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (provider) (count_over_time({service_name=\"auththread\"} | json | outcome=\"failed\" [$__range]))"
        }
      ]
    }
  ]
}
