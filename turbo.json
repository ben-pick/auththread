{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": [
    "biome.json",
    "tsconfig.base.json",
    ".dependency-cruiser.cjs"
  ],
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": [],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "web/app.js"]
    },
    "check": {
      "dependsOn": ["typecheck", "lint", "test"],
      "outputs": []
    }
  }
}
