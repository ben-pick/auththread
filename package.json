{
  "name": "auththread",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm boundaries && pnpm lint:ci && pnpm budget && pnpm agents:check && pnpm template:check",
    "build": "turbo run build",
    "pack:check": "node scripts/pack-check.ts",
    "template:check": "node scripts/template-check.ts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && pnpm pack:check && changeset publish",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:ci": "actionlint",
    "test": "turbo run test",
    "boundaries": "depcruise --config .dependency-cruiser.cjs packages",
    "agents:check": "node packages/tooling/agents/src/cli.ts check",
    "agents:index": "node packages/tooling/agents/src/cli.ts index",
    "demo": "node scripts/demo.ts",
    "smoke": "node scripts/smoke.ts",
    "graph": "node packages/tooling/dep-graph/src/cli.ts",
    "probe:auth0": "node scripts/auth0-probe.ts",
    "budget": "node packages/tooling/budget/src/cli.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@changesets/cli": "^3.0.3",
    "dependency-cruiser": "catalog:",
    "publint": "^0.3.25",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@auththread/adapter-kit": "workspace:*",
    "@auththread/auth0": "workspace:*",
    "@auththread/config": "workspace:^",
    "@auththread/oidc": "workspace:*",
    "@auththread/runtime-node": "workspace:*",
    "@auththread/schema": "workspace:*",
    "@auththread/sdk": "workspace:^",
    "@auththread/sink-wide-event": "workspace:*",
    "@auththread/stitcher": "workspace:*"
  }
}
